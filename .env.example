# Copy to .env. Values below match docker-compose.yml (local, fictitious credentials).
DATABASE_URL=postgres://orders:orders@localhost:5432/orders_dev
# Used only by the test suite; database name MUST end in _test.
TEST_DATABASE_URL=postgres://orders:orders@localhost:5432/orders_test

PORT=3000
LOG_LEVEL=info

# Retry policy
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000

# ERP client timeouts
ERP_TIMEOUT_MS=5000
ERP_LOOKUP_TIMEOUT_MS=3000

# Worker. LEASE_MS must be > ERP_TIMEOUT_MS + 2 * ERP_LOOKUP_TIMEOUT_MS + 5000
LEASE_MS=30000
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_ENABLED=true
