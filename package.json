{
  "name": "desafio-grupo-morada",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable order intake API forwarding sales orders to an unreliable ERP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/infra/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "for i in 1 2 3 4 5; do echo \"stress run $i/5\"; vitest run test/integration/concurrency- || exit 1; done",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:trace": "node scripts/check-traceability.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
